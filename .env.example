# Connector build / deploy / live-drive env. Copy to .env (gitignored) and fill in.
#
# NOTE: scripts/deploy.sh sources the SIBLING framework env
# (../../fsr-playbook-framework/.env) by default — so in the normal two-repo checkout
# you set creds THERE, not here. This file documents the connector-specific vars
# and the standalone-clone case (no sibling framework checkout).

# --- FSR box + auth (same as the framework .env) ---
FSR_BASE_URL=https://fsr-1.your.lab
FSR_API_KEY=
# or: FSR_USERNAME= / FSR_PASSWORD=
FSR_VERIFY_SSL=true            # connector scripts also accept FSR_VERIFY_TLS

# --- Agent (Anthropic) ---
# Pushed onto the connector config so the on-box agent can call Claude.
ANTHROPIC_API_KEY=

# --- Deploy knobs (scripts/deploy.sh, scripts/install_to_fsr.py) ---
# Named config to create/refresh on the box.
FSR_BUILDER_CONFIG_NAME=fsrpb-live
# Agent model. Testing pins Haiku (cheap); override to raise it.
FSR_BUILDER_MODEL=claude-haiku-4-5-20251001

# --- Cross-repo coupling (build needs the framework's fsr_core + reference DB) ---
# build.sh reads fsr_core + store/fsr_reference.db from FSR_SRC (default
# ../../fsr-playbook-framework). If the framework lives elsewhere, point these at it:
# FSRPLAYBOOKYAML_REPO=/path/to/fsr-playbook-framework
# FSR_REFERENCE_DB=/path/to/fsr_reference.db
